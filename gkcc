#
# gkcc, the GPU kernel compiler driver: the image's one entry point. A kernel
# source in, device code for one target out, whichever vendor's toolchain
# that target and language take.
set -euo pipefail

share=/usr/share/gpu-kernel-compiler
nvidia_mount=/opt/nvidia
nvidia_image=$(cat "$share/nvidia-image")

usage() {
    cat >&2 <<EOF
usage: gkcc --target TARGET [OPTION...] IN -o OUT
       gkcc --targets [-x LANG] | --manifest

Compiles IN ('-' reads stdin) for TARGET into OUT: a cubin for sm_*, an
AMD code object for gfx*, a zebin for dg2, SPIR-V 1.2 for emu. --targets
lists the targets, or with -x those that take LANG.

  -x LANG         the input language, by default from IN's extension:
                    cl    OpenCL C (.cl, and anything else), every target
                    ptx   PTX, what -S writes (.ptx), sm_*
                    cuda  CUDA C++ device code (.cu), sm_*
                    hip   HIP C++ device code (.hip), sm_* and gfx*
                    spirv OpenCL SPIR-V (.spv), dg2 and emu

  --prelude FILE  prepend FILE to the source, not for spirv; repeatable,
                  in order. The source's own directory stays on the
                  include path.
  --cuda-compiler C
                  what compiles cuda: clang, the default, or nvcc, from
                  NVIDIA's mounted image, with this image's g++ as host
                  compiler
  --ptxas OPT     pass OPT to ptxas (sm_* only); repeatable
  -S              sm_* only: stop at PTX, to be edited and passed back
  -DNAME[=VAL], -IDIR, -cl-*
                  build options, for every target; for spirv, -cl-*
                  only. -cl-intel-* go to ocloc's -internal_options.
  anything else   passed to clang, or nvcc, as is (sm_* and gfx* only)

The defaults are -cl-std=CL2.0 -O3 for cl and -O3 for cuda and hip, which
later options override, and for hip on gfx* -mprintf-kind=buffered, printf
into the kernel's printf buffer rather than calls to the host. OpenCL C's
printf on sm_* calls vprintf, through a shim gkcc links (shims/). sm_* targets need NVIDIA's CUDA (ptxas, libdevice,
headers and nvcc), which this image does not carry. Mount NVIDIA's image
read-only at $nvidia_mount:

  --mount type=image,src=$nvidia_image,dst=$nvidia_mount

Targets: $(tr '\n' ' ' <"$share/targets")
EOF
    exit "${1:-2}"
}

die() {
    echo "gkcc: $*" >&2
    exit 1
}

# The input languages target $1 takes
languages() {
    case $1 in
    sm_*) echo cl ptx cuda hip ;;
    gfx*) echo cl hip ;;
    dg2 | emu) echo cl spirv ;;
    esac
}

target="" src="" out="" lang="" asm=0 list=0 cuda_compiler=clang
preludes=() opts=() ptxas_opts=()
while (($#)); do
    case $1 in
    --targets) list=1 ;;
    --manifest) exec cat "$share/manifest" ;;
    -h | --help) usage 0 ;;
    --target=*) target=${1#*=} ;;
    --cuda-compiler=*) cuda_compiler=${1#*=} ;;
    --target | -o | -x | --prelude | --ptxas | --cuda-compiler | -D | -I | -Xclang | -include)
        (($# >= 2)) || usage
        case $1 in
        --target) target=$2 ;;
        -o) out=$2 ;;
        -x) lang=$2 ;;
        --prelude) preludes+=("$2") ;;
        --ptxas) ptxas_opts+=("$2") ;;
        --cuda-compiler) cuda_compiler=$2 ;;
        *) opts+=("$1" "$2") ;;
        esac
        shift
        ;;
    -S) asm=1 ;;
    -) [[ -z $src ]] || usage && src=- ;;
    -*) opts+=("$1") ;;
    *) [[ -z $src ]] || usage && src=$1 ;;
    esac
    shift
done
if ((list)); then
    while read -r t; do
        if [[ -z $lang || " $(languages "$t") " == *" $lang "* ]]; then echo "$t"; fi
    done <"$share/targets"
    exit 0
fi
[[ -n $target && -n $src && -n $out ]] || usage
grep -qx -- "$target" "$share/targets" ||
    die "no target $target; this image builds: $(tr '\n' ' ' <"$share/targets")"
if [[ -z $lang ]]; then
    case $src in
    *.ptx) lang=ptx ;;
    *.cu) lang=cuda ;;
    *.hip) lang=hip ;;
    *.spv) lang=spirv ;;
    *) lang=cl ;;
    esac
fi
case $lang in
cl | ptx | cuda | hip | spirv) ;;
*) die "no input language $lang; gkcc takes cl, ptx, cuda, hip and spirv" ;;
esac
if [[ " $(languages "$target") " != *" $lang "* ]]; then
    case $lang in
    cuda) die "-x cuda is for sm_* targets, CUDA being NVIDIA's; for gfx*, write HIP (-x hip)" ;;
    # The translators can turn SPIR-V into LLVM IR, but not lower OpenCL's
    # address spaces and kernels to amdgcn's or nvptx's (see README.md)
    spirv) die "-x spirv is for dg2 and emu; SPIR-V for $target is not implemented" ;;
    *) die "-x $lang is not for $target, which takes: $(languages "$target")" ;;
    esac
fi
if [[ $target != sm_* ]] && ((asm || ${#ptxas_opts[@]})); then
    die "-S and --ptxas are for sm_* targets only"
fi
case $cuda_compiler in
clang) ;;
nvcc) [[ $lang == cuda ]] || die "--cuda-compiler nvcc is for -x cuda" ;;
*) die "no CUDA compiler $cuda_compiler; gkcc takes clang and nvcc" ;;
esac
if [[ $lang == spirv ]]; then
    ((${#preludes[@]} == 0)) || die "--prelude is for source languages, not SPIR-V"
    for o in "${opts[@]}"; do
        case $o in -D* | -I*) die "$o is a source option; SPIR-V is compiled already" ;; esac
    done
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# A prelude, or stdin, puts the source in tmp; keep its includes resolving
if ((${#preludes[@]})) || [[ $src == - ]]; then
    [[ $src == - ]] || opts=(-I "$(dirname "$src")" "${opts[@]}")
    cat "${preludes[@]}" "$src" >"$tmp/input.$lang"
    src=$tmp/input.$lang
fi

CL=(-x cl -cl-std=CL2.0 -O3 -Xclang -finclude-default-header)
# The CUDA in the pinned image is newer than clang knows of; it compiles it
CUDA=(-x cuda --cuda-device-only -O3 -Wno-unknown-cuda-version)
# The linked code object, as hipcc --genco makes, not an offload bundle
HIP=(-x hip --cuda-device-only --no-gpu-bundle-output -O3)

# The path of $1 in NVIDIA's CUDA under the mount, or why there is none
nvidia_tool() {
    local cuda tool err
    for cuda in "$nvidia_mount"/usr/local/cuda-*; do :; done
    tool=$cuda/$1
    if [[ ! -e $tool ]]; then
        die "$target needs NVIDIA's CUDA (ptxas, libdevice, headers and nvcc), which this image does not carry." \
            "Add NVIDIA's image as a read-only mount:"$'\n'"  --mount type=image,src=$nvidia_image,dst=$nvidia_mount"
    fi
    if [[ $1 == bin/ptxas ]] && ! err=$("$tool" --version 2>&1); then
        die "$tool is mounted but does not run here ($err);" \
            "mount $nvidia_image, the image this one is tested with"
    fi
    echo "$tool"
}

case $target in
sm_*)
    if [[ $cuda_compiler == nvcc ]]; then
        # nvcc runs ptxas itself, or with -S stops before it
        nvcc=$(nvidia_tool bin/nvcc)
        kind=-cubin xptxas=()
        ((asm)) && kind=-ptx
        for o in "${ptxas_opts[@]}"; do xptxas+=(-Xptxas "$o"); done
        "$nvcc" -ccbin g++ -x cu "$kind" -arch="$target" "${xptxas[@]}" "${opts[@]}" \
            -o "$out" "$src"
        exit
    fi
    ptx=$src
    if [[ $lang != ptx ]]; then
        ptx=$tmp/kernel.ptx
        ((asm)) && ptx=$out
    fi
    case $lang in
    cl)
        libdevice=$(nvidia_tool nvvm/libdevice/libdevice.10.bc)
        # clang has no OpenCL builtin library for nvptx64: a kernel brings
        # its own work-item functions, and libdevice's __nv_* math is linked.
        # --cuda-path tells clang the CUDA version, which sets the PTX version;
        # without it, clang's default lacks e.g. the warp shuffles.
        # nor any printf: OpenCL's, which clang lowers to a call of printf
        # with constant-space strings, is shims/nvptx_printf.c's, calling vprintf
        clang -x c -std=c11 --target=nvptx64-nvidia-cuda -march="$target" --cuda-path="${libdevice%/nvvm/*}" -O2 -fno-builtin \
            -emit-llvm -c -o "$tmp/printf.bc" "$share/shims/nvptx_printf.c"
        clang "${CL[@]}" -target nvptx64-nvidia-cuda -march="$target" \
            --cuda-path="${libdevice%/nvvm/*}" \
            -Xclang -mlink-builtin-bitcode -Xclang "$libdevice" \
            -Xclang -mlink-builtin-bitcode -Xclang "$tmp/printf.bc" \
            "${opts[@]}" -S -o "$ptx" "$src"
        ;;
    cuda | hip)
        # clang finds libdevice under --cuda-path itself. nvcc puts CCCL
        # (cuda/std/...) on the include path from nvcc.profile; so must we.
        # HIP on NVIDIA is CUDA with HIP's headers, which see clang's CUDA
        # and take their nvidia_detail side.
        cuda=$(nvidia_tool include/cuda.h)
        cuda=${cuda%/include/*}
        hip=()
        [[ $lang == hip ]] && hip=(-isystem /opt/rocm/include)
        clang "${CUDA[@]}" --cuda-gpu-arch="$target" --cuda-path="$cuda" "${hip[@]}" \
            -isystem "$cuda/include/cccl" "${opts[@]}" -S -o "$ptx" "$src"
        ;;
    esac
    if ((!asm)); then
        ptxas=$(nvidia_tool bin/ptxas)
        "$ptxas" -arch="$target" "${ptxas_opts[@]}" -o "$out" "$ptx"
    fi
    ;;
emu)
    # PoCL's CPU device takes SPIR-V up to 1.2, clang's default is newer
    if [[ $lang == spirv ]]; then
        ((${#opts[@]} == 0)) || die "${opts[0]}: SPIR-V for emu is copied as it is, without options"
        why=$(kobj_check "$src=emu") ||
            die "$src is not what emu takes, SPIR-V up to 1.2 for OpenCL with 64-bit" \
                "addresses; kobj_check: ${why#*: }"
        cp "$src" "$out"
    else
        clang "${CL[@]}" --target=spirv64v1.2 "${opts[@]}" -c -o "$out" "$src"
    fi
    ;;
gfx*)
    if [[ $lang == hip ]]; then
        # printf into the buffer the kernarg's hidden_printf_buffer names,
        # as OpenCL C's does, rather than calls to the host
        /opt/rocm/lib/llvm/bin/clang "${HIP[@]}" --offload-arch="$target" -mprintf-kind=buffered \
            "${opts[@]}" -c -o "$out" "$src"
    else
        # clang lowers printf to calls of ockl's __printf_alloc after it
        # has linked the device libraries, which leaves them undefined, so
        # the lowered bitcode is compiled again with ockl linked
        /opt/rocm/lib/llvm/bin/clang "${CL[@]}" -target amdgcn-amd-amdhsa -mcpu="$target" \
            "${opts[@]}" -c -emit-llvm -o "$tmp/kernel.bc" "$src"
        /opt/rocm/lib/llvm/bin/clang -target amdgcn-amd-amdhsa -mcpu="$target" -O3 \
            -Xclang -mlink-builtin-bitcode -Xclang /opt/rocm/amdgcn/bitcode/ockl.bc \
            -Xclang -mlink-builtin-bitcode -Xclang /opt/rocm/amdgcn/bitcode/oclc_abi_version_500.bc \
            -c -o "$out" "$tmp/kernel.bc"
    fi
    ;;
*)
    options=() internal=() spirv=()
    if [[ $lang == spirv ]]; then
        spirv=(-spirv_input)
    else
        options=(-cl-std=CL2.0)
    fi
    for ((i = 0; i < ${#opts[@]}; i++)); do
        case ${opts[i]} in
        -D | -I) options+=("${opts[i]}${opts[i + 1]}") && i=$((i + 1)) ;;
        -cl-intel-*) internal+=("${opts[i]}") ;;
        -D* | -I* | -cl-*) options+=("${opts[i]}") ;;
        *) die "${opts[i]} is a clang option; ocloc takes -D, -I and -cl-* only" ;;
        esac
    done
    # ocloc names its output after -output, in -out_dir, with the SPIR-V beside it
    ocloc compile -q -device "$target" "${spirv[@]}" -file "$src" \
        ${options[@]+-options "${options[*]}"} \
        ${internal[@]+-internal_options "${internal[*]}"} \
        -output kernel -output_no_suffix -out_dir "$tmp"
    mv "$tmp/kernel.bin" "$out"
    ;;
esac
